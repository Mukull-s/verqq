# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (Defaults to local MongoDB)
MONGODB_URI=mongodb://localhost:27017/verq

# JWT Configuration
# Generate a strong, unique secret (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
# and set it in your real .env file. Never commit a real secret.
JWT_SECRET=
JWT_EXPIRES_IN=24h

# AI Configuration
# Primary LLM = Merge Gateway (DeepSeek V4.1 Flash, OpenAI-compatible).
# Fallback  = OpenRouter (Nemotron). Set at least one.
MERGE_GATEWAY_API_KEY=
MERGE_GATEWAY_BASE_URL=https://api-gateway.merge.dev/v1/openai
MERGE_GATEWAY_MODEL=deepseek/deepseek-v4.1-flash

OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Speech-to-text (required)
DEEPGRAM_API_KEY=

# Optional: per-request LLM timeout (ms)
LLM_TIMEOUT_MS=45000

# Seed candidate (development only; no default password is applied)
SEED_CANDIDATE_EMAIL=candidate@verq.com
SEED_CANDIDATE_NAME=Aman Aziz
SEED_CANDIDATE_PASSWORD= 